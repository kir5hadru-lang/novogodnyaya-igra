# База данных (локально SQLite)
DATABASE_URL="file:./dev.db"

# Адрес сайта — используется в ссылке из письма
APP_URL="http://localhost:3000"

# Цена игры в рублях
PRICE_RUB=299

# Оплата: mock (без реальных денег) или yookassa
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Почта (https://resend.com). Без ключа ссылка просто печатается в консоль сервера.
RESEND_API_KEY=
EMAIL_FROM="Новогодняя игра <onboarding@resend.dev>"
